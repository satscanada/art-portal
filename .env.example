# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Prefer the publishable key; anon key still works as fallback
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site branding
NEXT_PUBLIC_SITE_NAME=Lakshan's Art Gallery
NEXT_PUBLIC_ARTIST_NAME=Lakshan
NEXT_PUBLIC_SITE_TAGLINE=A living gallery of young art

# Pagination
NEXT_PUBLIC_PAGE_SIZE=12

NEXT_PUBLIC_SITE_URL=https://lakshanvs.com

# Optional: unlock richer semantic search phrasing (falls back to Postgres FTS)
# OPENAI_API_KEY=
